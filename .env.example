# Local PostgreSQL (without Docker): replace PASSWORD with the postgres user's password.
# With docker compose: postgres://ledger:ledger@localhost:5432/ledger
DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/ledger
# Separate throwaway DB for integration tests (they truncate all tables).
TEST_DATABASE_URL=postgres://postgres:PASSWORD@localhost:5432/ledger_test
# openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
FX_API_URL=https://api.frankfurter.app
# Stripe TEST mode (dashboard.stripe.com -> Developers -> API keys). Leave the placeholders
# and the card deposit form is simply hidden.
STRIPE_SECRET_KEY=sk_test_...
# Local: printed by `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# Deployed: the signing secret of the webhook endpoint in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: base URL for Stripe's success/cancel redirects (default: taken from the request).
# APP_URL=http://localhost:3000
# Optional: direct (non-pooled) connection for LISTEN/NOTIFY, e.g. Neon's URL without "-pooler".
# DATABASE_URL_UNPOOLED=
